# ──────────────────────────────────────────────────────────────────────
# /etc/bravo/auth.env  (template — copy to that path, fill secrets,
#                      chmod 0640, chown root:root)
#
# Loaded by bravo-auth.service via `--env-file`. Lines starting with
# `#` are comments. Do NOT quote values; docker --env-file does NOT
# strip surrounding quotes (it treats them as part of the value).
#
# Sources for each value:
#   - DATABASE_URL              → Supabase Project Settings → Database → Connection (use the pooler URL for serverless connections)
#   - REDIS_URL                 → wherever the EC2 host's Redis lives (MUST match messenger.env)
#   - JWT_ACCESS_SECRET         → generate once via `openssl rand -base64 64`. MUST match messenger.env (sealed-sender + ticket verification).
#   - TWILIO_*                  → Twilio console (Verify service SID + auth token)
#   - STRIPE_*                  → Stripe dashboard (test mode in staging)
#   - SENTRY_DSN                → Sentry project → Settings → Client Keys (audit fix 5.4)
#   - CORS_ALLOWED_ORIGINS      → comma-separated; in staging this is the Vercel preview alias
# ──────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# ── Postgres (Supabase) ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.qkkfkicgoncxslbwhyhz:<PASSWORD>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Redis (shared with messenger-service) ─────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0

# ── JWT ───────────────────────────────────────────────────────────────
# Audit fix 0.4 — shared with messenger-service so the messenger-ticket
# (5-min access JWT) verifies against the same secret.
JWT_ACCESS_SECRET=<replace-with-output-of-openssl-rand-base64-64>
JWT_ACTION_SECRET=<replace-with-output-of-openssl-rand-base64-64>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Audit fix 1.4 — strict validation ────────────────────────────────
# Flip to 'true' AFTER confirming the staging canary doesn't see a 400
# spike from stale mobile builds sending extra fields.
STRICT_VALIDATION=false

# ── E2E-20 — global HTTP rate limiting ───────────────────────────────
# The APP_GUARD (GlobalHttpThrottlerGuard) ENFORCES by default as of
# 2026-09-03. Before that it read THROTTLE_ENFORCE === 'true' and that
# variable was set in NO env, compose or infra file anywhere in the
# repo — so the limiter logged and never 429'd, which is how a single
# runaway client loop could saturate the 20-connection pg pool and
# 500 the whole fleet.
#
# Leave it 'true'. Set it to 'false' for ONE deploy only if a rollout
# 429s legitimate traffic: that reverts to [throttle-shadow] log lines
# (grep the journal for them) so the real per-IP rates can be sized.
# The global bucket is 600 req/min per IP (AppModule); the tight limits
# are the per-route @Throttle decorators, and the high-frequency
# pollers (telemetry, SOS, dispatch, family, vbg/news) bind
# UserThrottlerGuard and are per-USER, not per-IP.
#
# ⚠️ Throttler storage is IN-MEMORY: every limit is multiplied by the
#    replica count. Redis-backed ThrottlerStorage is required BEFORE
#    running a second auth-service replica.
THROTTLE_ENFORCE=true

# ── E2E-21 — Node heap ceiling ───────────────────────────────────────
# NORMALLY SET BY THE SYSTEMD UNIT, NOT HERE. bravo-auth.service passes
# `-e NODE_OPTIONS=--max-old-space-size=1024` next to `--memory=1536m`
# so the cgroup limit and the heap ceiling that must track it live in
# one file. Set it here ONLY if you run the container by hand, and keep
# it at ~2/3 of the container's memory limit — V8 sizes its heap from
# HOST memory, not the cgroup, so without a ceiling the process is
# OOM-killed mid-GC instead of throwing a recoverable heap error.
# NODE_OPTIONS=--max-old-space-size=1024

# ── E2E-12 — scheduled-booking late-cancel window ────────────────────
# Hours before the contracted pickup_time inside which cancelling a
# SCHEDULED booking (Executive Protection, or any booking_mode='later')
# that already holds escrow pays the ops-configured cancel_fee_pct.
# Outside it, cancelling is free. 0 DISABLES the rule and restores the
# pre-2026-09-03 behaviour (fee only once crew was committed) — that is
# the rollback. Secure Transfer ON-DEMAND is unaffected either way.
BOOKING_LATE_CANCEL_HOURS=12

# ── E2E-04 / E2E-11 — scheduled auto-dispatch windows ────────────────
# Minutes before pickup_time that the scheduled sweep starts searching.
# EP searches far earlier: it has a 3 h minimum lead, sells 3-24 h
# blocks, reserves nothing before an agency accepts, and exhaustion is
# terminal — 15 minutes of warning is not recoverable, 24 h is.
DISPATCH_SCHEDULED_LEAD_MINUTES=15
DISPATCH_EP_SCHEDULED_LEAD_MINUTES=1440
# Minutes past pickup_time after which a parked, never-dispatched
# booking is CLOSED OUT (CANCELLED + refund + ops page) instead of
# dispatched. Must exceed every benign delay (pod restart, clock skew)
# and stay under "a slot the client would still want".
DISPATCH_STALE_START_FLOOR_MINUTES=30
# Minutes a scheduled booking may sit DISPATCHING with no live offer
# before the sweep re-drives its cascade.
DISPATCH_SCHEDULED_RETRY_MINUTES=5

# ── 2026-09-03 audit — settlement / EP-lifecycle tunables ────────────
# Minutes past pickup_time before the assigned lead may declare a CLIENT
# no-show (settles PARTIAL on cancel_fee_pct, stamps no_show_at so the
# client's dispute door can tell it from a cancellation).
DISPATCH_CLIENT_NO_SHOW_GRACE_MINUTES=20
# How fresh the lead's SERVER-STAMPED mission_telemetry fix must be for that
# declaration to be accepted. The body-supplied fix was removed as farmable —
# the party who profits from the no-show would have been the one stating where
# they stood — so this bounds the age of the server's own evidence.
DISPATCH_NO_SHOW_FIX_MAX_AGE_MINUTES=10
# Minutes a COMPLETED booking's escrow may sit HELD (settlement threw
# after completion) before the retry sweep re-runs it, and how many
# attempts it gets before it stops and pages a human.
DISPATCH_SETTLE_RETRY_GRACE_MINUTES=10
DISPATCH_SETTLE_MAX_ATTEMPTS=5
# Minutes past pickup_time + duration_hours before an EP block is treated
# as ended, and minutes past an hourly check-in's due time before it
# counts as missed.
DISPATCH_EP_BLOCK_END_GRACE_MINUTES=15
DISPATCH_CHECKIN_OVERDUE_GRACE_MINUTES=20
# Minimum hourly check-ins an EP mission needs for its completion proof
# to pass (the transport-shaped gate can fail a stationary site detail).
DISPATCH_EP_MIN_CHECKINS=1

# ── E2E-25 — dispatch ranking candidate cap ──────────────────────────
# How many NEAREST agencies the per-row eligibility/capacity plpgsql
# functions may run over. Raise only if a region genuinely has more
# than this many on-duty agencies inside DISPATCH_RADIUS_M.
DISPATCH_RANK_CANDIDATE_CAP=200

# ── Audit fix 1.6 — CORS ─────────────────────────────────────────────
# Comma-separated allowed origins. Empty + NODE_ENV=production throws
# on boot (main.ts:84 — fail-closed). For staging this is the ops
# console Vercel preview alias.
CORS_ALLOWED_ORIGINS=https://ops-staging.bravosecure.app

# ── OTP / Twilio ─────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_DEV_RETURN_CODE=false
OTP_DEV_BYPASS=false
TWILIO_ACCOUNT_SID=<AC…>
TWILIO_AUTH_TOKEN=<…>
TWILIO_FROM=+1<…>
TWILIO_VERIFY_SID=VA<…>

# ── TOTP encryption (audit reference: TOTP module) ───────────────────
# 64-char hex (32 bytes). Generate via `openssl rand -hex 32`.
TOTP_ENCRYPTION_KEY=<64-char-hex>
TOTP_ISSUER=Bravo Secure

# ── Integration settings encryption (ops console → Integrations tab) ─
# 32 bytes. Encrypts the Stripe/Twilio/Mapbox/biometric secrets admins save in
# the console (AES-256-GCM, table platform_settings). This is the ONE key that
# must stay in env. Generate: `openssl rand -base64 32`. Losing or changing it
# makes saved secrets undecryptable (servers fall back to env) — back it up
# with the database. See docs/runbooks/INTEGRATION_SETTINGS.md.
SETTINGS_ENCRYPTION_KEY=<base64-of-32-bytes>

# ── Biometric device-check (mobile attestation) ──────────────────────
BIOMETRIC_DEV_BYPASS=false
GOOGLE_PLAY_INTEGRITY_KEY=
ANDROID_PACKAGE_NAME=com.bravosecure
APPLE_TEAM_ID=
APPLE_DEVICE_CHECK_KEY_ID=
APPLE_DEVICE_CHECK_P8_KEY=

# ── Kafka (optional in staging) ──────────────────────────────────────
KAFKA_BROKERS=
KAFKA_AUDIT_TOPIC=audit-events

# ── Audit fix 5.4 — Sentry ───────────────────────────────────────────
# Leave blank to disable. The shim no-ops when this is unset.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Stripe (Lite payments) ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_<…>
STRIPE_WEBHOOK_SECRET=whsec_<…>

# ── Supabase (for service-role calls from server) ────────────────────
SUPABASE_URL=https://qkkfkicgoncxslbwhyhz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt-from-supabase-settings-api>

# ── Sender cert (messenger E2EE) ─────────────────────────────────────
SENDER_CERT_ISSUER=auth-service
