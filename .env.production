# Release-build env (NODE_ENV=production). Loaded by `expo export:embed` during
# `./gradlew assembleRelease`. `npm run android` bundles in development mode and
# never reads this file, so local dev keeps using .env (127.0.0.1). Process env
# (apk:staging/apk:dist via cross-env) still overrides — @expo/env never
# overrides a var already present in process.env. EXPO_PUBLIC_* (client-public) only.
# Production (2026-10-08) — bravosecure.cloud on the Hostinger VPS
# (deploy/production/README.md §6). The old 94-136-184-52.sslip.io staging
# values live on in the explicit apk:staging / android:staging scripts only.
EXPO_PUBLIC_API_BASE_URL=https://auth.bravosecure.cloud
EXPO_PUBLIC_MSG_BASE_URL=https://relay.bravosecure.cloud
EXPO_PUBLIC_SUPABASE_URL=https://api.bravosecure.cloud
# EXPO_PUBLIC_SUPABASE_ANON_KEY and EXPO_PUBLIC_SENDER_CERT_PUBLIC_KEY_B64 are
# generated on the VPS (deploy/production/make-env.sh prints both) and differ
# per installation, so they are NOT tracked: put them in .env.production.local
# next to the Mapbox token. scripts/check-release-env.mjs refuses to build
# without them.
# EXPO_PUBLIC_MAPBOX_TOKEN is NOT here on purpose (2026-09-27): GitHub push
# protection rejects Mapbox tokens, so it lives in the gitignored
# .env.production.local, which @expo/env loads with HIGHER precedence than
# this file. Missing it fails the apk:* scripts early (scripts/check-mapbox-
# token.mjs) instead of shipping a map-less build (B-89 MG-04). EAS cloud
# builds get it from an EAS env var — docs/runbooks/MOBILE_BUILD_ENV.md.
# B-51 — feature flags previously set ONLY inline in the apk:staging script;
# the Firebase release pipeline (release-apk.ps1 / bare gradlew) bakes THIS
# file, so v1.0.100 shipped with both flags silently OFF (Departmental card
# vanished for providers). Keep in lockstep with the apk:staging script env.
EXPO_PUBLIC_AUTO_DISPATCH=true
EXPO_PUBLIC_DEPT_CHAT_V2=true
